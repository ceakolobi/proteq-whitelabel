# ============================================================
# Proteq White-Label — variáveis de ambiente
# Copie para .env e preencha com os dados do cliente.
# NUNCA commite o .env com valores reais.
# ============================================================

# --- Branding -------------------------------------------------
VITE_APP_NAME=Proteq
VITE_APP_URL=proteq.antum.com.br
# Cor primária em hex (opcional — usa o Tailwind padrão se vazio)
VITE_PRIMARY_COLOR=#f97316

# --- Storage keys (evitar colisão entre tenants) --------------
VITE_SESSION_KEY=proteqUser
VITE_THEME_KEY=proteq-theme

# --- Supabase (projeto exclusivo por cliente) -----------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
